# Cloud LLM (Groq) + a built-in JSON vector store — no Docker, no local
# services to run. Only local piece left is the embedding model, which
# downloads once (~90MB) via @xenova/transformers and then runs offline.

# GitHub — create a Personal Access Token with repo scope for local dev
# (for production, register a GitHub App instead — see README)
GITHUB_TOKEN=

# Secret you choose yourself, used to verify GitHub webhook payloads
GITHUB_WEBHOOK_SECRET=

# The repo this agent reviews, format: owner/repo
TARGET_REPO=

# Groq — free tier, no credit card required: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Built-in vector store — path to the committed JSON file of embeddings
VECTOR_STORE_PATH=./data/embeddings.json

# Port for the webhook server (Render sets this automatically in production)
PORT=3000
